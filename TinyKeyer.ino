 * Programmable via USBasp or as a Trinket@16MHz via USB pads  in Arduino IDE
 */

#include "setup.h"
#include "yack.h"
#include "commands.h"

// Power-up greeting message stored in Flash memory (e.g. "73")
static const char imok[] PROGMEM = MSG_GREETING;

void setup()
{
    // 1. Initialize hardware, pins, timers, and load parameters from EEPROM
    yackinit();

    // 2. Play sidetone audio greeting at power-on to confirm operation ("73")
    yackinhibit(ON);
    yackstring(imok);
    yackinhibit(OFF);
}

void loop()
{
    // 1. Check command button press -> switch to interactive command mode
    if (yackctrlkey(TRUE))
    {
        commandmode();
    }

    // 2. Maintain system rhythm (5 ms heartbeat generated by Timer1)
    yackbeat();

    // 3. Play automatic beacon if enabled (configured via 'N' command)
    beacon(PLAY);

    // 4. Run IAMBIC keyer finite state machine for paddles
    yackiambic(OFF);
}
